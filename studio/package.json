{
  "name": "@aparadeckav2/studio",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "dev": "sanity dev",
    "lint": "eslint .",
    "schema:extract": "sanity schemas extract",
    "start": "sanity start",
    "typecheck": "tsc --noEmit",
    "typegen": "sanity typegen generate",
    "types": "npm run schema:extract && npm run typegen"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/vision": "^6.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.11.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/react": "^19.2.18",
    "eslint": "^9.39",
    "prettier": "^3.9",
    "typescript": "^5.9"
  },
  "prettier": {
    "bracketSpacing": false,
    "printWidth": 100,
    "semi": false,
    "singleQuote": true
  }
