---
import '@fontsource/caladea/latin-400.css';
import '@fontsource/caladea/latin-ext-400.css';
import '@fontsource/caladea/latin-700.css';
import '@fontsource/caladea/latin-ext-700.css';
import '@fontsource/calistoga/latin-400.css';
import '@fontsource/calistoga/latin-ext-400.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-ext-400.css';
import type { SanityImageSource } from '@sanity/image-url';

import caladeaLatin400 from '@fontsource/caladea/files/caladea-latin-400-normal.woff2?url';
import caladeaLatin700 from '@fontsource/caladea/files/caladea-latin-700-normal.woff2?url';
import caladeaLatinExt400 from '@fontsource/caladea/files/caladea-latin-ext-400-normal.woff2?url';
import caladeaLatinExt700 from '@fontsource/caladea/files/caladea-latin-ext-700-normal.woff2?url';
import calistogaLatin400 from '@fontsource/calistoga/files/calistoga-latin-400-normal.woff2?url';
import calistogaLatinExt400 from '@fontsource/calistoga/files/calistoga-latin-ext-400-normal.woff2?url';
import interLatin400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';

import '../styles/globals.scss';
import '../styles/view-transitions.css';
import '../../../shared/tokens.css';
import '../../../shared/rich-text.css';

import interLatinExt400 from '@fontsource/inter/files/inter-latin-ext-400-normal.woff2?url';
import { sanityClient } from 'sanity:client';

import { siteUrl } from '../../siteUrl';
import Navigation from '../components/navigation/Navigation.astro';
import { ogImageQuery, siteQuery } from '../lib/queries';
import { urlForImage } from '../lib/sanity';

interface Props {
	description?: string;
	image?: null | SanityImageSource;
	preloadFonts?: Array<'bold' | 'sans'>;
	title?: string;
}

const { description, image, preloadFonts = [], title } = Astro.props;

const fontFaces = {
	bold: [caladeaLatin700, caladeaLatinExt700],
	sans: [interLatin400, interLatinExt400],
};

const preloadedFonts = [
	caladeaLatin400,
	caladeaLatinExt400,
	calistogaLatin400,
	calistogaLatinExt400,
	...preloadFonts.flatMap((face) => fontFaces[face]),
];

const site = await sanityClient.fetch<{
  description: null | string;
  keywords: null | string[];
  siteTitle: null | string;
}>(siteQuery);

const siteName = site?.siteTitle ?? 'Agnieszka Paradecka - Świtalska';
const resolvedTitle = title ?? siteName;
const resolvedDescription =
	description ?? site?.description ?? 'Agnieszka Paradecka - Świtalska - Portfolio';

const canonical = new URL(Astro.url.pathname, siteUrl).href;

const ogImageSource = image ?? (await sanityClient.fetch<null | SanityImageSource>(ogImageQuery));
const ogImage = ogImageSource
	? urlForImage(ogImageSource).width(1200).fit('max').format('jpg').url()
	: null;

const personJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Person',
	description: resolvedDescription,
	image: ogImage,
	name: siteName,
	url: siteUrl,
});

const speculationRules = JSON.stringify({
	prefetch: [
		{
			eagerness: 'moderate',
			source: 'document',
			/* Same-origin documents, excluding anything with a query string. */
			where: { and: [{ href_matches: '/*' }, { not: { href_matches: '/*\\?*' } }] },
		},
	],
});
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width" name="viewport" />
		<meta content={resolvedDescription} name="description" />
		{site?.keywords?.length && <meta content={site.keywords.join(', ')} name="keywords" />}
		<meta content={canonical} property="og:url" />
		<meta content="website" property="og:type" />
		<meta content="pl_PL" property="og:locale" />
		<meta content={siteName} property="og:site_name" />
		<meta content={resolvedTitle} property="og:title" />
		<meta content={resolvedDescription} property="og:description" />
		{ogImage && <meta content={ogImage} property="og:image" />}
		<meta content={ogImage ? 'summary_large_image' : 'summary'} name="twitter:card" />
		<meta content={resolvedTitle} name="twitter:title" />
		<meta content={resolvedDescription} name="twitter:description" />
		{ogImage && <meta content={ogImage} name="twitter:image" />}
		<link href="/apple-touch-icon.png" rel="apple-touch-icon" sizes="180x180" />
		<link href="/favicon-16x16.png" rel="icon" sizes="16x16" type="image/png" />
		<link href="/favicon-32x32.png" rel="icon" sizes="32x32" type="image/png" />
		<link href="/favicon.ico" rel="icon" />
		<link href="/site.webmanifest" rel="manifest" />
		<link href={canonical} rel="canonical" />
		<meta content={Astro.generator} name="generator" />
		{preloadedFonts.map((href) => (
			<link as="font" crossorigin href={href} rel="preload" type="font/woff2" />
		))}
		<slot name="head" />
		<title>{resolvedTitle}</title>
		<script is:inline set:html={speculationRules} type="speculationrules"></script>
		<script is:inline set:html={personJsonLd} type="application/ld+json"></script>
	</head>
	<body>
		<a class="skip-link" href="#main">Przejdź do treści</a>
		<Navigation />
		<main id="main">
			<slot />
		</main>
	</body>
</html>

<style>
	main {
		padding: var(--space-0) var(--space-4);
		max-width: var(--container-width);
		margin: 0 auto;
	}

	.skip-link {
		position: absolute;
		left: -9999px;
		z-index: 1;
		padding: var(--space-2) var(--space-3);
		background-color: var(--color-bg);
		color: var(--color-text);
		text-decoration: none;
	}

	.skip-link:focus-visible {
		top: var(--space-2);
		left: var(--space-2);
		outline: var(--focus-ring-width) solid var(--color-accent);
		outline-offset: var(--focus-ring-offset);
	}
</style>
