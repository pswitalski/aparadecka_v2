---
import '@fontsource/caladea/400.css';
import '@fontsource/caladea/700.css';
import '@fontsource/calistoga/400.css';
import '../styles/tokens.scss';

import { sanityClient } from 'sanity:client';
import { siteQuery } from '../lib/queries';
import Navigation from '../components/navigation/Navigation.astro';

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;

const site = await sanityClient.fetch<{
	title: string | null;
	description: string | null;
	keywords: string[] | null;
}>(siteQuery);

const resolvedTitle = title ?? site?.title ?? 'Agnieszka Paradecka – Świtalska';
const resolvedDescription =
	description ?? site?.description ?? 'Agnieszka Paradecka – Świtalska – Portfolio';
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={resolvedDescription} />
		{site?.keywords?.length && <meta name="keywords" content={site.keywords.join(', ')} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{resolvedTitle}</title>
	</head>
	<body>
		<Navigation />
		<main>
			<slot />
		</main>
	</body>
</html>

<style>
	main {
		padding: var(--page-padding);
		max-width: var(--container-width);
		margin: 0 auto;
	}
</style>
