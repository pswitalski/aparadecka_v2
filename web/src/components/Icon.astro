---
interface Props {
	name: 'close' | 'menu';
}

const { name } = Astro.props;

const icons = {
	close: { height: 26.25, viewBox: '0 0 24 24', width: 26.25 },
	menu: { height: 12, viewBox: '0 0 25 12', width: 25 },
} as const;

const icon = icons[name];
---

<svg
	aria-hidden="true"
	fill="none"
	height={icon.height}
	stroke="currentColor"
	stroke-linecap="round"
	stroke-width="2"
	viewBox={icon.viewBox}
	width={icon.width}
>
	{name === 'menu' && (
		<>
			<line stroke-linecap="butt" x1="0" x2="25" y1="1" y2="1" />
			<line stroke-linecap="butt" x1="0" x2="25" y1="6" y2="6" />
			<line stroke-linecap="butt" x1="0" x2="25" y1="11" y2="11" />
		</>
	)}
	{name === 'close' && (
		<>
			<line x1="6" x2="18" y1="6" y2="18" />
			<line x1="6" x2="18" y1="18" y2="6" />
		</>
	)}
</svg>
