---
import type { Painting } from '../lib/types';

import { imageDimensions, imageSrcSet, imageUrl } from '../lib/sanity';

interface Props {
	class?: string;
	painting: Painting;
	priority?: boolean;
	showYear?: boolean;
	year?: number;
}

const {
	class: className,
	painting,
	priority = false,
	showYear = false,
	year,
	...rest
} = Astro.props;

const previewUrl = painting.mainImage ? imageUrl(painting.mainImage, { width: 1600 }) : null;
const lightboxUrl = painting.mainImage ? imageUrl(painting.mainImage, { width: 2400 }) : null;
const previewSrcSet = painting.mainImage ? imageSrcSet(painting.mainImage) : undefined;
const dimensions = painting.mainImage ? imageDimensions(painting.mainImage) : null;
const details = [painting.medium, painting.support, painting.dimensions].filter(Boolean).join(', ');
const lightboxCaption = [painting.title ? `„${painting.title}”` : 'Bez tytułu', details].filter(Boolean).join(' ');
---

<figure class:list={['painting', 'painting--detail', className]} {...rest}>
	{previewUrl && (
		<button
			aria-label={`Powiększ obraz: ${painting.title ?? 'bez tytułu'}`}
			class="painting__image-button"
			data-lightbox-alt={painting.title ?? 'Obraz'}
			data-lightbox-caption={lightboxCaption}
			data-lightbox-src={lightboxUrl ?? previewUrl}
			data-lightbox-trigger
			type="button"
		>
			<img
				alt={painting.title ?? 'Obraz'}
				decoding={priority ? 'sync' : 'async'}
				fetchpriority={priority ? 'high' : undefined}
				height={dimensions?.height}
				loading={priority ? 'eager' : 'lazy'}
				sizes="(min-width: 1025px) min(60vw, 670px), calc(100vw - 2rem)"
				src={previewUrl}
				srcset={previewSrcSet}
				width={dimensions?.width}
			/>
		</button>
	)}
	<figcaption>
		{showYear && (year ?? painting.year) && <p class="painting__year">{year ?? painting.year}</p>}
		<span class="painting__caption-content">
			<strong>{painting.title ?? 'Bez tytułu'}</strong>
			{details && <span>{details}</span>}
		</span>
	</figcaption>
</figure>

<style lang="scss">
	.painting {
		margin: 0;
	}

	.painting--detail {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
		column-gap: clamp(var(--space-5), 6vw, var(--space-7));
		align-items: stretch;
	}

	.painting--detail img {
		display: block;
		height: auto;
		margin-inline: auto;
		max-width: 100%;
		object-fit: contain;

		@media (min-width: 1025px) {
			max-height: 560px;
		}
	}

	.painting--detail .painting__image-button {
		background: transparent;
		border: 0;
		cursor: zoom-in;
		display: block;
		grid-column: 2;
		grid-row: 1;
		padding: 0;
		width: 100%;
	}

	.painting--detail .painting__image-button:focus-visible {
		outline: var(--focus-ring-width) solid var(--color-accent);
		outline-offset: var(--focus-ring-offset);
	}

	.painting--detail figcaption {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		grid-column: 1;
		grid-row: 1;
		justify-self: stretch;
		justify-content: flex-end;
		text-align: left;
	}

	.painting--detail .painting__caption-content {
		display: grid;
		gap: var(--space-2);
	}

	.painting--detail figcaption strong {
		font-family: var(--font-special);
		font-size: var(--font-size-2xl);
		font-weight: 400;
	}

	.painting--detail .painting__caption-content span {
		font-size: var(--font-size-lg);
		line-height: 1.25;
	}

	.painting__year {
		font-family: var(--font-special);
		font-size: var(--font-size-5xl);
		line-height: inherit;
		margin-bottom: auto;
	}

	@media (min-width: 1025px) {
		.painting--detail figcaption {
			text-align: right;
		}
	}

	@media (max-width: 1024px) {
		.painting--detail {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}

		.painting--detail img,
		.painting--detail figcaption,
		.painting--detail .painting__image-button {
			grid-column: 1;
			grid-row: auto;
		}

		.painting--detail figcaption {
			text-align: center;
		}

		.painting__year {
			font-size: var(--font-size-3xl);
		}

		.painting--detail .painting__year {
			display: none;
		}
	}
</style>
