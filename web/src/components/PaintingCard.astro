---
import type { Painting } from '../lib/types';
import { urlForImage } from '../lib/sanity';

const { painting } = Astro.props as { painting: Painting };

const imageUrl = painting.mainImage
	? urlForImage(painting.mainImage).width(600).format('webp').url()
	: null;
---

<figure class="painting">
	{imageUrl && <img src={imageUrl} alt={painting.title ?? ''} loading="lazy" />}
	<figcaption>
		<p class="title">{painting.title ?? 'Bez tytułu'}</p>
		<ul class="meta">
			{painting.year && <li>{painting.year}</li>}
			{painting.medium && <li>{painting.medium}</li>}
			{painting.support && <li>{painting.support}</li>}
			{painting.dimensions && <li>{painting.dimensions}</li>}
		</ul>
	</figcaption>
</figure>

<style>
	.painting {
		margin: 0;
	}
	.painting img {
		display: block;
		width: 100%;
		height: auto;
	}
	.meta {
		list-style: none;
		padding: 0;
		margin: var(--space-1) 0 0;
		display: flex;
		gap: var(--space-3);
		color: var(--color-muted);
	}
	.title {
		margin: var(--space-2) 0 0;
	}
</style>
