---
import type { Painting } from '../lib/types';

import { urlForImage } from '../lib/sanity';

interface Props {
	class?: string;
	painting: Painting;
	variant?: 'detail' | 'featured' | 'thumb';
}

const { class: className, painting, variant = 'thumb', ...rest } = Astro.props;

const imageUrl = painting.mainImage ? urlForImage(painting.mainImage).width(1600).fit('max').format('webp').url() : null;
const imageSrcSet = painting.mainImage
	? [640, 960, 1280, 1600].map((width) => `${urlForImage(painting.mainImage!).width(width).fit('max').format('webp').url()} ${width}w`).join(', ')
	: undefined;
const caption = [painting.title ? `„${painting.title}”` : 'Bez tytułu', painting.medium, painting.support, painting.dimensions]
	.filter(Boolean)
	.join(', ');
---

<figure class:list={['painting', `painting--${variant}`, className]} {...rest}>
	{imageUrl && (
		<img
			alt={painting.title ?? 'Obraz'}
			decoding="async"
			loading={variant === 'detail' ? 'eager' : 'lazy'}
			sizes={variant === 'detail' ? '(min-width: 1025px) 70vw, 100vw' : '(min-width: 768px) 25vw, 50vw'}
			src={imageUrl}
			srcset={imageSrcSet}
		/>
	)}
	{(variant === 'thumb' || variant === 'detail') && <figcaption>{variant === 'detail' ? caption : painting.title ?? 'Bez tytułu'}</figcaption>}
</figure>

<style lang="scss">
	.painting {
		margin: 0;
	}

	/* Featured — shows the whole painting inside the gallery stage */
	.painting--featured {
		position: relative;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.painting--featured img {
		display: block;
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
		pointer-events: auto;
	}

	.painting--detail {
		display: grid;
		gap: var(--space-3);
	}

	.painting--detail img {
		display: block;
		height: auto;
		max-height: 78dvh;
		max-width: 100%;
		object-fit: contain;
		width: auto;
	}

	.painting--detail figcaption {
		font-size: var(--font-size-lg);
		line-height: 1.2;
		text-align: center;
	}

	/* Thumb — fixed 1.4 ratio, centered crop */
	.painting--thumb {
		position: relative;
		overflow: hidden;
	}

	.painting--thumb img {
		display: block;
		width: 100%;
		aspect-ratio: 1.4;
		object-fit: cover;
		object-position: center;
	}

	.painting--thumb figcaption {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: var(--space-4) var(--space-3) var(--space-2);
		color: #fff;
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		text-align: center;
		text-wrap: balance;
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
		opacity: 0;
		transform: translateY(4px);
		transition:
			opacity 200ms ease,
			transform 200ms ease;
	}

	.painting--thumb:hover figcaption,
	.painting--thumb:focus-within figcaption {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.painting--thumb figcaption {
			transition: none;
		}
	}
</style>
