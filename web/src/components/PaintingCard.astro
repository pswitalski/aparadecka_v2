---
import type { Painting } from '../lib/types';

import { urlForImage } from '../lib/sanity';

interface Props {
	class?: string;
	painting: Painting;
	variant?: 'featured' | 'thumb';
}

const { class: className, painting, variant = 'thumb', ...rest } = Astro.props;

const imageUrl = painting.mainImage
	? urlForImage(painting.mainImage).width(600).format('webp').url()
	: null;
---

<figure class:list={['painting', `painting--${variant}`, className]} {...rest}>
	{imageUrl && <img alt={painting.title ?? ''} loading="lazy" src={imageUrl} />}
	{variant === 'thumb' && <figcaption>{painting.title ?? 'Bez tytułu'}</figcaption>}
</figure>

<style lang="scss">
	.painting {
		margin: 0;
	}

	/* Featured — shows the whole painting inside the gallery stage */
	.painting--featured {
		position: relative;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.painting--featured img {
		display: block;
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
		pointer-events: auto;
	}

	/* Thumb — fixed 1.4 ratio, centered crop */
	.painting--thumb {
		position: relative;
		overflow: hidden;
	}

	.painting--thumb img {
		display: block;
		width: 100%;
		aspect-ratio: 1.4;
		object-fit: cover;
		object-position: center;
	}

	.painting--thumb figcaption {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: var(--space-4) var(--space-3) var(--space-2);
		color: #fff;
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		text-align: center;
		text-wrap: balance;
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
		opacity: 0;
		transform: translateY(4px);
		transition:
			opacity 200ms ease,
			transform 200ms ease;
	}

	.painting--thumb:hover figcaption,
	.painting--thumb:focus-within figcaption {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.painting--thumb figcaption {
			transition: none;
		}
	}
</style>
