---
import type { Painting } from '../lib/types';

import { urlForImage } from '../lib/sanity';

interface Props {
	class?: string;
	painting: Painting;
	showYear?: boolean;
	variant?: 'detail' | 'featured' | 'thumb';
	year?: number;
}

const { class: className, painting, showYear = false, variant = 'thumb', year, ...rest } = Astro.props;

const imageUrl = painting.mainImage ? urlForImage(painting.mainImage).width(1600).fit('max').format('webp').url() : null;
const imageSrcSet = painting.mainImage
	? [640, 960, 1280, 1600].map((width) => `${urlForImage(painting.mainImage!).width(width).fit('max').format('webp').url()} ${width}w`).join(', ')
	: undefined;
const details = [painting.medium, painting.support, painting.dimensions].filter(Boolean).join(', ');
---

<figure class:list={['painting', `painting--${variant}`, className]} {...rest}>
	{imageUrl && (
		<img
			alt={painting.title ?? 'Obraz'}
			decoding="async"
			loading={variant === 'detail' ? 'eager' : 'lazy'}
			sizes={variant === 'detail' ? '(min-width: 1025px) 70vw, 100vw' : '(min-width: 768px) 25vw, 50vw'}
			src={imageUrl}
			srcset={imageSrcSet}
		/>
	)}
	{variant === 'detail' ? (
		<figcaption>
			{showYear && (year ?? painting.year) && <span class="painting__year">{year ?? painting.year}</span>}
			<strong>{painting.title ?? 'Bez tytułu'}</strong>
			{details && <span>{details}</span>}
		</figcaption>
	) : (
		variant === 'thumb' && <figcaption>{painting.title ?? 'Bez tytułu'}</figcaption>
	)}
</figure>

<style lang="scss">
	.painting {
		margin: 0;
	}

	/* Featured — shows the whole painting inside the gallery stage */
	.painting--featured {
		position: relative;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.painting--featured img {
		display: block;
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
		pointer-events: auto;
	}

	.painting--detail {
		display: grid;
		grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
		column-gap: clamp(var(--space-5), 6vw, var(--space-7));
		align-items: stretch;
	}

	.painting--detail img {
		display: block;
		height: clamp(320px, 34vw, 560px);
		max-width: 100%;
		object-fit: contain;
		width: 100%;
		grid-column: 2;
		grid-row: 1;
	}

	.painting--detail figcaption {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		grid-column: 1;
		grid-row: 1;
		justify-self: stretch;
		justify-content: flex-end;
		text-align: left;
	}

	.painting--detail figcaption strong {
		font-family: var(--font-special);
		font-size: var(--font-size-2xl);
		font-weight: 400;
	}

	.painting--detail figcaption span:not(.painting__year) {
		font-size: var(--font-size-lg);
		line-height: 1.25;
	}

	.painting__year {
		font-family: var(--font-special);
		font-size: var(--font-size-5xl);
		margin-bottom: auto;
	}

	@media (min-width: 1025px) {
		.painting--detail figcaption {
			text-align: right;
		}
	}

	/* Thumb — fixed 1.4 ratio, centered crop */
	.painting--thumb {
		position: relative;
		overflow: hidden;
	}

	.painting--thumb img {
		display: block;
		width: 100%;
		aspect-ratio: 1.4;
		object-fit: cover;
		object-position: center;
	}

	.painting--thumb figcaption {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: var(--space-4) var(--space-3) var(--space-2);
		color: #fff;
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		text-align: center;
		text-wrap: balance;
		background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
		opacity: 0;
		transform: translateY(4px);
		transition:
			opacity 200ms ease,
			transform 200ms ease;
	}

	.painting--thumb:hover figcaption,
	.painting--thumb:focus-within figcaption {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.painting--thumb figcaption {
			transition: none;
		}
	}

	@media (max-width: 1024px) {
		.painting--detail {
			grid-template-columns: 1fr;
			gap: var(--space-3);
		}

		.painting--detail img,
		.painting--detail figcaption {
			grid-column: 1;
			grid-row: auto;
		}

		.painting--detail img {
			height: auto;
		}

		.painting--detail figcaption {
			text-align: center;
		}

		.painting__year {
			font-size: var(--font-size-3xl);
		}

		.painting--detail .painting__year {
			display: none;
		}
	}
</style>
