---
import type { SanityImageSource } from '@sanity/image-url';
import { urlForImage } from '../lib/sanity';

interface ImageNode {
	asset?: SanityImageSource;
	alt?: string;
}

const { node } = Astro.props as { node: ImageNode };

const imageUrl = node.asset ? urlForImage(node.asset).width(800).format('webp').url() : null;
---

{imageUrl && <img src={imageUrl} alt={node.alt ?? ''} loading="lazy" />}
