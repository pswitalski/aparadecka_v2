---
import type { SanityImageSource } from '@sanity/image-url';

import { imageDimensions, imageSrcSet, imageUrl } from '../lib/sanity';

interface ImageNode {
	alt?: string;
	asset?: SanityImageSource;
}

const { node } = Astro.props as { node: ImageNode };

const asset = node.asset;
const dimensions = asset ? imageDimensions(asset) : null;
---

{asset && (
	<img
		alt={node.alt ?? ''}
		decoding="async"
		height={dimensions?.height}
		loading="lazy"
		sizes="calc(min(100vw, 1200px) - 6rem)"
		src={imageUrl(asset, { width: 800 })}
		srcset={imageSrcSet(asset)}
		width={dimensions?.width}
	/>
)}
