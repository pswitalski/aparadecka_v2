---
interface Props {
	class?: string;
	label: string;
}

const { class: className, label, ...attrs } = Astro.props;
---

<button aria-label={label} class:list={['icon-button', className]} type="button" {...attrs}>
	<slot />
</button>

<style>
	.icon-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
	}

	.icon-button:focus-visible {
		outline: var(--focus-ring-width) solid var(--color-accent);
		outline-offset: var(--focus-ring-offset);
	}
</style>
