---
import type { NavLink } from './links';

interface Props {
	links: NavLink[];
	orientation?: 'column' | 'row';
}

const { links, orientation = 'column' } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
	const target = href.replace(/\/+$/, '') || '/';
	return target === '/' ? currentPath === '/' : currentPath === target || currentPath.startsWith(target + '/');
};
---

<ul class:list={[orientation === 'row' && 'nav-links--row']}>
	{links.map((link) => {
		const active = isActive(link.href);
		return (
			<li>
				<a
					aria-current={active ? 'page' : undefined}
					class={active ? 'active' : undefined}
					href={link.href}
				>
					{link.label}
				</a>
			</li>
		);
	})}
</ul>

<style lang="scss">
	@use '../../styles/breakpoints';

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.nav-links--row {
		flex-direction: row;
	}

	a {
		font-family: var(--font-special);
		font-size: var(--font-size-3xl);
		color: var(--color-text);
		text-decoration: none;
	}

	a:focus-visible {
		outline: var(--focus-ring-width) solid var(--color-accent);
		outline-offset: var(--focus-ring-offset);
	}

	a.active {
		text-decoration: underline;
	}

	/* Below $breakpoints.mobile — nav link font size */
	@include breakpoints.max-width(mobile) {
		a {
			font-size: var(--font-size-xl);
		}
	}
</style>
