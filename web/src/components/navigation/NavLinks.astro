---
import type { NavLink } from './links';

interface Props {
	links: NavLink[];
	orientation?: 'row' | 'column';
}

const { links, orientation = 'column' } = Astro.props;
---

<ul class:list={[orientation === 'row' && 'nav-links--row']}>
	{links.map((link) => (
		<li>
			<a href={link.href}>{link.label}</a>
		</li>
	))}
</ul>

<style lang="scss">
	@use '../../styles/breakpoints';

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
	}

	.nav-links--row {
		flex-direction: row;
	}

	a {
		font-family: var(--font-special);
		font-size: var(--font-size-3xl);
		color: var(--color-text);
		text-decoration: none;
	}

	a:focus-visible {
		outline: var(--focus-ring-width) solid var(--color-accent);
		outline-offset: var(--focus-ring-offset);
	}

	/* Below $breakpoints.nav — nav link font size */
	@include breakpoints.max-width(nav) {
		a {
			font-size: var(--font-size-xl);
		}
	}
</style>
