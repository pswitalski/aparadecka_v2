---
import DesktopNav from './DesktopNav.astro';
import { navLinks } from './links';
import MobileMenu from './MobileMenu.astro';

const [home, ...links] = navLinks;

const isHome = Astro.url.pathname.replace(/\/+$/, '') === '';
---

<header class="site-header">
	<a class:list={['site-name', isHome && 'site-name--active']} href={home.href}>{home.label}</a>
	<DesktopNav links={links} />
	<MobileMenu links={links} />
</header>

<style lang="scss">
	@use '../../styles/breakpoints';

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		padding: var(--space-4);
		background-color: var(--color-bg);
		height: var(--header-height);
		max-width: var(--container-width);
		margin: 0 auto;
	}

	.site-name {
		font-family: var(--font-special);
		font-size: var(--font-size-3xl);
		color: var(--color-text);
		text-decoration: none;
		white-space: nowrap;
	}

	.site-name--active {
		text-decoration: underline;
	}

	.site-name:focus-visible {
		outline: var(--focus-ring-width) solid var(--color-accent);
		outline-offset: var(--focus-ring-offset);
	}

	/* Below $breakpoints.nav — mobile header height + nav font size */
	@include breakpoints.max-width(nav) {
		.site-header {
			height: var(--header-height-mobile);
		}

		.site-name {
			font-size: var(--font-size-xl);
		}
	}
</style>
