---
import type { NavLink } from './links';

import NavLinks from './NavLinks.astro';

interface Props {
	links: NavLink[];
}

const { links } = Astro.props;
---

<nav aria-label="Nawigacja główna" class="desktop-nav">
	<NavLinks links={links} orientation="row" />
</nav>

<style lang="scss">
	@use '../../styles/breakpoints';

	/* Below $breakpoints.nav — desktop nav is hidden */
	@include breakpoints.max-width(nav) {
		.desktop-nav {
			display: none;
		}
	}
</style>
