---
import type { NavLink } from './links';

import Icon from '../Icon.astro';
import IconButton from '../IconButton.astro';
import NavLinks from './NavLinks.astro';

interface Props {
	id?: string;
	links: NavLink[];
}

const { id = 'mobile-menu', links } = Astro.props;
---

<div class="menu-toggle-wrap">
	<IconButton
		aria-controls={id}
		aria-expanded="false"
		data-menu-toggle
		label="Otwórz menu"
	>
		<Icon name="menu" />
	</IconButton>
</div>

<dialog aria-label="Menu" class="mobile-menu" id={id}>
	<IconButton class="menu-close" data-menu-close label="Zamknij menu">
		<Icon name="close" />
	</IconButton>
	<nav aria-label="Nawigacja mobilna">
		<NavLinks links={links} />
	</nav>
</dialog>

<style lang="scss">
	@use '../../styles/breakpoints';

	.menu-toggle-wrap {
		display: none;
	}

	.mobile-menu {
		--nav-transition: 200ms ease;

		margin: 0;
		padding: var(--space-7) var(--space-4);
		border: 0;
		background-color: var(--color-panel);
	}

	/* Below $breakpoints.nav — mobile menu is active */
	@include breakpoints.max-width(nav) {
		.menu-toggle-wrap {
			display: block;
		}

		.mobile-menu {
			position: fixed;
			top: 0;
			right: 0;
			bottom: auto;
			left: 0;
			width: 100%;
			max-width: 100%;
			margin: 0;
			height: auto;
			max-height: 100dvh;
			overflow-y: auto;
			padding: var(--space-4) 0 var(--space-5);
			transform: translateY(-100%);
			transition: transform var(--nav-transition);
		}

		.mobile-menu[open] {
			transform: translateY(0);
		}

		.mobile-menu[open].is-closing {
			transform: translateY(-100%);
		}

		@starting-style {
			.mobile-menu[open] {
				transform: translateY(-100%);
			}
		}

		.mobile-menu::backdrop {
			background-color: transparent;
			transition: background-color var(--nav-transition);
		}

		.mobile-menu[open]::backdrop {
			background-color: var(--color-overlay);
		}

		.mobile-menu[open].is-closing::backdrop {
			background-color: transparent;
		}

		@starting-style {
			.mobile-menu[open]::backdrop {
				background-color: transparent;
			}
		}

		:global(.menu-close) {
			position: absolute;
			top: calc((var(--header-height-mobile) - 40px) / 2);
			right: 12px;
		}

		:global(.mobile-menu nav) {
			margin-top: var(--space-7);
		}

		:global(.mobile-menu nav a) {
			display: block;
			text-align: center;
			padding: 0 var(--space-4);
			text-decoration: none;
		}

		:global(.mobile-menu nav a.active) {
			background-color: var(--color-bg);
			text-decoration: none;
		}
	}

	/* At/above $breakpoints.nav — mobile menu is hidden */
	@include breakpoints.min-width(nav) {
		.menu-toggle-wrap,
		.mobile-menu {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mobile-menu,
		.mobile-menu::backdrop {
			transition: none;
		}
	}

	:global(html.is-menu-open),
	:global(html.is-menu-open body) {
		overflow: hidden;
	}
</style>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('dialog.mobile-menu');
	const toggle = dialog ? document.querySelector(`[aria-controls="${dialog.id}"]`) : null;

	if (dialog && toggle) {
		const closeButton = dialog.querySelector('[data-menu-close]');
		const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const setOpenState = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
			document.documentElement.classList.toggle('is-menu-open', open);
		};

		const openMenu = () => {
			dialog.classList.remove('is-closing');
			dialog.showModal();
			setOpenState(true);
		};

		const closeMenu = () => {
			if (!dialog.open) return;

			if (prefersReducedMotion) {
				dialog.close();
				return;
			}

			dialog.classList.add('is-closing');

			let done = false;
			const finish = () => {
				if (done) return;
				done = true;
				dialog.classList.remove('is-closing');
				dialog.close();
			};

			const onTransitionEnd = (event: TransitionEvent) => {
				if (event.propertyName === 'transform' && dialog.classList.contains('is-closing')) {
					finish();
				}
			};

			dialog.addEventListener('transitionend', onTransitionEnd, { once: true });
			window.setTimeout(finish, 400);
		};

		toggle.addEventListener('click', () => {
			if (dialog.open) {
				closeMenu();
			} else {
				openMenu();
			}
		});

		closeButton?.addEventListener('click', closeMenu);

		dialog.addEventListener('click', (event: MouseEvent) => {
			if (event.target === dialog) {
				closeMenu();
			}
		});

		dialog.addEventListener('cancel', (event: Event) => {
			event.preventDefault();
			closeMenu();
		});

		dialog.addEventListener('close', () => {
			setOpenState(false);
		});

		const breakpoint = Number.parseInt(
			getComputedStyle(document.documentElement).getPropertyValue('--breakpoint-nav'),
			10,
		);
		const desktopQuery = window.matchMedia(`(min-width: ${Number.isNaN(breakpoint) ? 768 : breakpoint}px)`);

		const onViewportChange = () => {
			if (desktopQuery.matches && dialog.open) {
				closeMenu();
			}
		};

		desktopQuery.addEventListener('change', onViewportChange);
	}
</script>
