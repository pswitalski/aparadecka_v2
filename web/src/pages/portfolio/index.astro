---
import { sanityClient } from 'sanity:client';

import type { Painting } from '../../lib/types';

import Layout from '../../layouts/main.astro';
import { collectionsQuery } from '../../lib/queries';
import { displayedCropRect, imageDimensions, imageSrcSet, imageUrl } from '../../lib/sanity';

interface CollectionItem {
	featuredPainting: null | Painting;
	year: number;
}

const collections = await sanityClient.fetch<CollectionItem[]>(collectionsQuery);
/* The grid is three columns on desktop, so two rows — six cards — are on screen at
   a typical desktop height. Those load eagerly; the rest stay lazy. */
const EAGER_CARDS = 6;

/* The card box is square while the file is a 3:2 crop, so CSS discards the sides. Crop that
   same square at the CDN instead, and the download holds nothing the browser throws away. */
const cards = collections.map((collection) => {
	const mainImage = collection.featuredPainting?.mainImage ?? null;
	const dimensions = mainImage ? imageDimensions(mainImage) : null;

	return {
		...collection,
		mainImage,
		rect: dimensions ? displayedCropRect(dimensions, { displayRatio: 1, sentRatio: 1.5 }) : undefined,
	};
});
---

<Layout title="Portfolio">
	<div class="portfolio-wrapper">
		<ul class="years">
			{cards.map(({ featuredPainting, mainImage, rect, year }, index) => (
				<li class="year-card">
					<a href={`/portfolio/${year}`}>
						{mainImage ? (
							<span class="year-card__image-wrap">
								<img
									alt={featuredPainting?.title ?? `Praca z ${year}`}
									decoding={index < EAGER_CARDS ? 'sync' : 'async'}
									fetchpriority={index === 0 ? 'high' : undefined}
									loading={index < EAGER_CARDS ? 'eager' : 'lazy'}
									sizes="(min-width: 1025px) calc((min(100vw, 1200px) - 5rem) / 3), (min-width: 768px) calc((min(100vw, 1200px) - 2 * clamp(1.5rem, 7vw, 3rem) - 1rem) / 2), calc(100vw - 2 * clamp(1.5rem, 7vw, 3rem))"
									src={imageUrl(mainImage, { ratio: 1, rect, width: 1200 })}
									srcset={imageSrcSet(mainImage, { ratio: 1, rect })}
								/>
								<span class="year-card__year">{year}</span>
							</span>
						) : (
							<span aria-hidden="true" class="year-card__image-wrap year-card__image-wrap--empty">
								<span>{year}</span>
							</span>
						)}
					</a>
				</li>
			))}
		</ul>
	</div>
</Layout>

<style lang="scss">
	.portfolio-wrapper {
		background: var(--color-surface);
		margin-inline: calc(50% - 50vw);
	}

	.years {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-5);
		list-style: none;
		padding: clamp(var(--space-5), 7vw, var(--space-7));
		max-width: var(--container-width);

		@media (min-width: 1025px) {
			margin: 0 auto;
			padding: clamp(var(--space-5), 7vw, var(--space-7)) var(--space-4);
		}
	}

	.year-card a {
		color: inherit;
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		text-decoration: none;
	}

	.year-card__image-wrap {
		background: var(--color-surface);
		display: block;
		justify-self: center;
		max-width: 1100px;
		position: relative;
		width: min(100%, 1100px);
	}

	.year-card__image-wrap img {
		aspect-ratio: 1;
		display: block;
		height: auto;
		object-fit: cover;
		width: 100%;
	}

	.year-card__year {
		align-items: center;
		background: transparent;
		color: var(--color-text);
		display: flex;
		font-family: var(--font-special);
		font-size: var(--font-size-2xl);
		justify-content: center;
		padding: var(--space-2) var(--space-1) 0;
		text-shadow: none;
	}

	.year-card__image-wrap--empty {
		align-items: center;
		aspect-ratio: 1;
		display: flex;
		font-family: var(--font-special);
		font-size: var(--font-size-3xl);
		justify-content: center;
	}

	@media (hover: hover) and (pointer: fine) {
		.year-card__year {
			background: rgba(255, 255, 255, 0.72);
			font-size: clamp(var(--font-size-3xl), 6vw, var(--font-size-5xl));
			inset: 0;
			opacity: 0;
			padding: 0;
			position: absolute;
			transition: opacity 180ms ease;
		}

		.year-card a:hover .year-card__year,
		.year-card a:focus-visible .year-card__year {
			opacity: 1;
		}

		.year-card a:focus-visible {
			outline: var(--focus-ring-width) solid var(--color-accent);
			outline-offset: var(--focus-ring-offset);
		}
	}

	@media (max-width: 1024px) {
		.years {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--space-6) var(--space-4);
		}
	}

	@media (max-width: 767px) {
		.years {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.year-card__year {
			transition: none;
		}
	}
</style>
