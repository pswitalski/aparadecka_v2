---
import { sanityClient } from 'sanity:client';

import type { Painting } from '../../lib/types';

import Layout from '../../layouts/main.astro';
import { collectionsQuery } from '../../lib/queries';
import { urlForImage } from '../../lib/sanity';

interface CollectionItem {
	thumbnail: null | Painting;
	year: number;
}

const collections = await sanityClient.fetch<CollectionItem[]>(collectionsQuery);
---

<Layout title="Portfolio">
	<h1>Portfolio</h1>
	<ul class="grid years">
		{collections.map(({ thumbnail, year }) => (
			<li>
				<a href={`/portfolio/${year}`}>
					{thumbnail?.mainImage && (
						<img
							alt={thumbnail.title ?? ''}
							loading="lazy"
							src={urlForImage(thumbnail.mainImage).width(400).format('webp').url()}
						/>
					)}
					<span>{year}</span>
				</a>
			</li>
		))}
	</ul>
</Layout>

<style>
	.years {
		list-style: none;
		padding: 0;
	}
	.years a {
		font-family: var(--font-special);
		text-decoration: none;
		color: var(--color-text);
	}
	.years img {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
