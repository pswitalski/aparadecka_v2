---
import Layout from '../layouts/main.astro';
import AboutSections from '../components/about/AboutSections.astro';
import { sanityClient } from 'sanity:client';
import { aboutQuery } from '../lib/queries';

const data = await sanityClient.fetch(aboutQuery);
const sections = data?.sections;
---

<Layout title="O mnie">
  <div class="about-page">
    <div class="about-page__inner">
      <h1 class="visually-hidden">O mnie</h1>
      {sections?.length ? <AboutSections sections={sections} /> : <p>Brak treści.</p>}
    </div>
  </div>
</Layout>

<style>
  .about-page {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    background: var(--color-surface);
    overflow-x: clip;
  }

  .about-page__inner {
    max-width: var(--container-width);
    margin-inline: auto;
    padding: var(--space-4);
  }
</style>
