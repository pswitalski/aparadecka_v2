---
import Layout from '../layouts/main.astro';
import PaintingCard from '../components/PaintingCard.astro';
import { sanityClient } from 'sanity:client';
import { featuredPaintingsQuery } from '../lib/queries';
import type { Painting } from '../lib/types';

const { featured } = await sanityClient.fetch<{ featured: Painting[] }>(featuredPaintingsQuery);
---

<Layout>
	<h1>Wyróżnione obrazy</h1>
	<div class="grid">
		{(featured ?? []).map((painting) => <PaintingCard painting={painting} />)}
	</div>
</Layout>
