---
import Layout from '../layouts/main.astro';
import HomePageGallery from '../components/home-gallery/HomePageGallery';
import { adaptPaintings } from '../components/home-gallery/HomePageGallery.adapter';
import { sanityClient } from 'sanity:client';
import { featuredPaintingsQuery } from '../lib/queries';
import type { Painting } from '../lib/types';

const { featuredPaintings } = await sanityClient.fetch<{ featuredPaintings: Painting[] }>(featuredPaintingsQuery);

const paintings = adaptPaintings(featuredPaintings);
---

<Layout>
	<h1 class="visually-hidden">Wyróżnione obrazy</h1>
	<HomePageGallery paintings={paintings} client:load />
</Layout>
