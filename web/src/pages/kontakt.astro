---
import Layout from '../layouts/main.astro';
import { sanityClient } from 'sanity:client';
import { contactQuery } from '../lib/queries';

interface SocialLink {
	label: string | null;
	url: string;
}

const contact = await sanityClient.fetch<{
	email: SocialLink | null;
	instagram: SocialLink | null;
	facebook: SocialLink | null;
}>(contactQuery);

const links = [
	{ key: 'email', ...contact.email },
	{ key: 'instagram', ...contact.instagram },
	{ key: 'facebook', ...contact.facebook },
].filter((link): link is { key: string; label: string | null; url: string } => Boolean(link.url));
---

<Layout title="Kontakt">
	<h1>Kontakt</h1>
	{links.length > 0 ? (
		<ul class="links">
			{links.map((link) => (
				<li>
					<a href={link.url}>{link.label ?? link.key}</a>
				</li>
			))}
		</ul>
	) : null}
</Layout>

<style>
	.links {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}
	.links a {
		color: var(--color-accent);
	}
</style>
