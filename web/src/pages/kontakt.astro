---
import { sanityClient } from 'sanity:client';

import ContactForm from '../components/contact/ContactForm.astro';
import SocialLinks from '../components/contact/SocialLinks.astro';
import Layout from '../layouts/main.astro';
import { contactQuery } from '../lib/queries';

type SocialKey = 'email' | 'facebook' | 'instagram';

interface SocialLink {
	label: null | string;
	url: string;
}

interface ContactLink extends SocialLink {
	key: SocialKey;
}

const contact = await sanityClient.fetch<{
	email: null | SocialLink;
	facebook: null | SocialLink;
	instagram: null | SocialLink;
}>(contactQuery);

const links = (
	[
		{ key: 'email', ...contact.email },
		{ key: 'instagram', ...contact.instagram },
		{ key: 'facebook', ...contact.facebook },
	] as Array<ContactLink | Record<string, unknown>>
)
	.filter((link): link is ContactLink => Boolean((link as ContactLink).url))
	.map(({ key, label, url }) => ({ key, label, url }));
---

<Layout title="Kontakt">
	<section class="contact-page">
		<div class="contact-page__inner">
			<h1 class="visually-hidden">Kontakt</h1>
			<div class="contact-page__grid">
				<ContactForm />
				{links.length > 0 && <SocialLinks links={links} />}
			</div>
		</div>
	</section>
</Layout>

<style lang="scss">
	@use '../styles/breakpoints';

	.contact-page {
		width: 100vw;
		margin-inline: calc(50% - 50vw);
		margin-top: calc(-1 * var(--space-4));
		background: var(--color-surface);
		overflow-x: clip;
	}

	.contact-page__inner {
		max-width: var(--container-width);
		margin-inline: auto;
	}

	.contact-page__grid {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		padding: 24px var(--space-4) 46px;
	}

	/* Tablet (and below): stack the section, fill the viewport, anchor icons to the bottom */
	@include breakpoints.max-width(tablet) {
		.contact-page {
			margin-bottom: calc(-1 * var(--space-4));
		}

		.contact-page__grid {
			flex-direction: column;
			align-items: center;
			gap: 36px;
			padding: 24px var(--space-4) calc(var(--space-5) + env(safe-area-inset-bottom));
			min-height: calc(100vh - var(--header-height));
			min-height: calc(100dvh - var(--header-height));
		}

		.contact-page__grid > :global(.social-links) {
			margin-top: auto;
			margin-bottom: 12px;
		}
	}

	/* Phone: the header is shorter, so re-measure the viewport fill */
	@include breakpoints.max-width(mobile) {
		.contact-page__grid {
			min-height: calc(100vh - var(--header-height-mobile));
			min-height: calc(100dvh - var(--header-height-mobile));
		}
	}
</style>
