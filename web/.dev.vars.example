CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id>
CLOUDFLARE_EMAIL_API_TOKEN=<api-token-with-Email-Sending-Edit>
# Recipients of contact-form notifications, comma-separated. Each must be a verified
# destination address in Cloudflare.
CONTACT_NOTIFICATION_EMAIL=<page-owner@example.com>,<second-owner@example.com>
CONTACT_FROM_EMAIL=kontakt@agnieszkaparadecka.pl
# Turnstile secret key (Cloudflare dashboard → Turnstile). The KV binding
# `CONTACT_RATE_LIMIT` is configured on the Pages project, not in this file.
TURNSTILE_SECRET_KEY=<turnstile-secret-key>
